# Copy this file to .env and fill in your own machine's LAN IP.
# .env is gitignored on purpose — this value is different for every developer
# and changes whenever you reconnect to a different Wi-Fi network.
#
# Find your LAN IP:
#   Mac:     ipconfig getifaddr en0
#   Windows: ipconfig  (look for "IPv4 Address")
#
# 127.0.0.1 only works when testing in a web browser on the same machine as
# the backend. A phone or simulator needs your machine's real network address.
EXPO_PUBLIC_API_URL=http://192.168.1.42:5000/api
