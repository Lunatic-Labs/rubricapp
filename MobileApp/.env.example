# Only needed for web testing, tunnel mode, or production builds — when
# testing on a physical device/simulator over LAN, src/constants/api.ts
# auto-detects your machine's current IP from Expo's own dev server
# connection, so you normally don't need to set or update this at all.
#
# If you do need it (web, tunnel, or as a manual override), copy this file
# to .env and fill in your own machine's LAN IP. .env is gitignored — this
# value is different for every developer.
#
# Find your LAN IP:
#   Mac:     ipconfig getifaddr en0
#   Windows: ipconfig  (look for "IPv4 Address")
EXPO_PUBLIC_API_URL=http://192.168.1.42:5050/api
